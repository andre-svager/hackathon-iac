# Copy this file to terraform.tfvars and fill in real values.
# terraform.tfvars should be in .gitignore — never commit real passwords.

aws_region  = "us-east-1"
environment = "production"

ngo_db_username      = "ngo_admin"
ngo_db_password      = "CHANGE_ME"       # prefer AWS Secrets Manager / SSM in real deployments
donation_db_username = "donation_admin"
donation_db_password = "CHANGE_ME"       # prefer AWS Secrets Manager / SSM in real deployments
